Number of Islands

https://leetcode.com/problems/number-of-islands/description/

class Solution {
    public int numIslands(char[][] grid) {
       int count=0;
       int m=grid.length;
       int n=grid[0].length;
       for(int i=0;i<m;i++) {
        for(int j=0;j<n;j++){
             if (grid[i][j] == '1') {
            count++;
            dfs(i,j,grid);
            
        }}}
       return count;
    }
    public void dfs(int i,int j,char[][] grid){
         int m=grid.length;
       int n=grid[0].length;
       
    if (i < 0 || j < 0 || i >= m || j >= n || grid[i][j] != '1') {
            return;
      }
      grid[i][j]=0;
      dfs(i+1,j,grid); dfs(i,j+1,grid); dfs(i-1,j,grid); dfs(i,j-1,grid);
    }
    
}

Flood Fill

https://leetcode.com/problems/flood-fill/description/

class Solution {
    public int[][] floodFill(int[][] image, int sr, int sc, int color) {

        int col=image[sr][sc];
        dfs(image,color,sr,sc,col);
        return image;
    }
    public void dfs(int[][] grid,int color,int i,int j,int col){
       if(col == color) return ;
       int n=grid.length;
       int m=grid[0].length;

      if(i < 0 || j < 0 || i >= n || j >= m || grid[i][j] != col){
          return;
       }
       grid[i][j]=color;
       dfs(grid,color,i+1,j,col);
       dfs(grid,color,i-1,j,col);
       dfs(grid,color,i,j+1,col);
       dfs(grid,color,i,j-1,col);
       
    }
}

ROTTING ORANGES

https://leetcode.com/problems/rotting-oranges/

class Solution {
    public int orangesRotting(int[][] grid) {
       int m = grid.length, n = grid[0].length;
       
       int[][] dir = {{1,0},{-1,0},{0,1},{0,-1}};
       Queue<int[]> g=new LinkedList<>();
         int fr=0;
       for(int i=0;i<m;i++){
            for(int j=0;j<n;j++){

                if(grid[i][j]==2){
                    g.offer(new int[]{i,j});
                }
                if(grid[i][j]==1)
                fr++;

                


            }
        }
        if(fr==0){
            return 0;
        }
        int time=0;

        while(!g.isEmpty()){
            int size=g.size();
            for(int i=0;i<size;i++){
            int[] cur=g.poll();
           
            for(int[] d:dir){
             int l=cur[0]+d[0];
             int r=cur[1]+d[1];
             if(l>=0&&r>=0&&l<m&&r<n&&grid[l][r]==1){
             grid[l][r]=2;
             g.offer(new int[]{l,r});
                fr--;
             }
            }
            }
            time++;
        }


    return fr==0?time-1:-1;
 }
}
