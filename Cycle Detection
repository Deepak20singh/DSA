UNDIRECTED GRAPH

class Main {

    static int[] par;
    static int[] rank;

    // Initialize DSU
    static void init(int n) {
        par = new int[n + 1];
        rank = new int[n + 1];

        for (int i = 0; i <= n; i++) {
            par[i] = i;
            rank[i] = 0;
        }
    }

    // Find with path compression
    public static int find(int x) {
        if (par[x] != x) {
            par[x] = find(par[x]);
        }
        return par[x];
    }

    // Union by rank
    public static boolean union(int u, int v) {
        int pu = find(u);
        int pv = find(v);

        if (pu == pv) {
            return false;
        }

        // par[pv]=pu;

        if (rank[pu] < rank[pv]) {
            par[pu] = pv;
        } else if (rank[pu] > rank[pv]) {
            par[pv] = pu;
        } else {
            par[pv] = pu;
            rank[pu]++;
        }
        return true;
    }

    public static void main(String[] args) {
       
 int n = 5;
        int[][] edges = {
            {1, 2},
            {2, 3},
            {3, 1}, // cycle
            {4, 5},
            {5, 4}  // cycle
        };

        init(n);
        int count=0;
        for(int[] e:edges){
            if(!union(e[0],e[1])){
                count++;
            }
        }
        System.out.println(count);
}}



<-----  REDUNDANT CONNECTION ------>

https://leetcode.com/problems/redundant-connection/description/

class Solution {

    public boolean dfs(int src, int target, boolean[] visited, List<List<Integer>> graph){
        if(src == target) return true;

        visited[src] = true;

        for(int nei : graph.get(src)){
            if(!visited[nei]){
                if(dfs(nei, target, visited, graph)){
                    return true;
                }
            }
        }
        return false;
    }

    public int[] findRedundantConnection(int[][] edges) {
        int n = edges.length;

        List<List<Integer>> graph = new ArrayList<>();
        for(int i = 0; i <= n; i++){
            graph.add(new ArrayList<>());
        }

        for(int[] e : edges){
            int u = e[0];
            int v = e[1];

            boolean[] visited = new boolean[n + 1];

            // check if already connected
            if(dfs(u, v, visited, graph)){
                return e; // cycle edge
            }

            // add edge
            graph.get(u).add(v);
            graph.get(v).add(u);
        }

        return new int[]{};
    }
}

IS GRAPH BIPARTITE

https://leetcode.com/problems/is-graph-bipartite

class Solution {
    public boolean isBipartite(int[][] graph) {
        int n = graph.length;
        int[] color = new int[n];

        for (int i = 0; i < n; i++) {

            // ✅ only unvisited nodes
            if (color[i] == 0) {
                if (!dfs(graph, color, i, 1)) {
                    return false;
                }
            }
        }

        return true;
    }

    public boolean dfs(int[][] graph, int[] color, int i, int c) {
        color[i] = c;

        for (int nei : graph[i]) {

            // ❌ same color conflict
            if (color[nei] == c) {
                return false;
            }

            // visit unvisited neighbor
            if (color[nei] == 0) {
                if (!dfs(graph, color, nei, -c)) {
                    return false;
                }
            }
        }

        return true;
    }
}


BFS

import java.util.*;

class Solution {
    public boolean isBipartite(int[][] graph) {
        int n = graph.length;
        int[] color = new int[n];

        for (int i = 0; i < n; i++) {
            if (color[i] != 0) continue;

            Queue<Integer> q = new LinkedList<>();
            q.offer(i);
            color[i] = 1;

            while (!q.isEmpty()) {
                int r = q.poll();

                for (int nei : graph[r]) {

                    // ✅ correct check
                    if (color[nei] == color[r]) {
                        return false;
                    }

                    // ✅ correct coloring
                    if (color[nei] == 0) {
                        color[nei] = -color[r];
                        q.offer(nei);
                    }
                }
            }
        }

        return true;
    }
}


