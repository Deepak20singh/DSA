import java.util.*;

public class AllCyclesUndirected {

    static List<List<Integer>> result = new ArrayList<>();

    public static void main(String[] args) {
        int n = 5;
        List<List<Integer>> adj = new ArrayList<>();

        for(int i = 0; i < n; i++) adj.add(new ArrayList<>());

        // Example graph
        addEdge(adj, 0, 1);
        addEdge(adj, 1, 2);
        addEdge(adj, 2, 0);
        addEdge(adj, 1, 3);
        addEdge(adj, 3, 4);
        addEdge(adj, 4, 1);

        boolean[] visited = new boolean[n];
        List<Integer> path = new ArrayList<>();

        dfs(0, -1, adj, visited, path);

        for(List<Integer> cycle : result) {
            System.out.println(cycle);
        }
    }

    static void addEdge(List<List<Integer>> adj, int u, int v) {
        adj.get(u).add(v);
        adj.get(v).add(u);
    }

    static void dfs(int node, int parent, List<List<Integer>> adj,
                    boolean[] visited, List<Integer> path) {

        visited[node] = true;
        path.add(node);

        for(int nei : adj.get(node)) {

            if(!visited[nei]) {
                dfs(nei, node, adj, visited, path);
            }
            else if(nei != parent) {
                // cycle found
                List<Integer> cycle = new ArrayList<>();

                for(int i = path.size() - 1; i >= 0; i--) {
                    cycle.add(path.get(i));
                    if(path.get(i) == nei) break;
                }

                Collections.reverse(cycle);
                result.add(cycle);
            }
        }

        path.remove(path.size() - 1);
    }
}


