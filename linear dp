






https://leetcode.com/problems/house-robber/

class Solution {
    public int rob(int[] nums) {
        int dp[]=new int[nums.length];
        Arrays.fill(dp,-1);
        return ans(nums,dp,0);
    }
    public int ans(int[] nums,int[] dp,int s){
        if(s>=nums.length){
            return 0;
        }
        if(dp[s]!=-1){
            return dp[s];
        }
        
        int pick=nums[s]+ans(nums,dp,s+2);
        int nPick=ans(nums,dp,s+1);
        return dp[s]=Math.max(pick,nPick);
        
    }
}
