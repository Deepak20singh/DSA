import java.util.*;

class Solution {

    int[] parent;

    // FIND
    int find(int x) {

        if(parent[x] == x)
            return x;

        return parent[x] = find(parent[x]);
    }

    // UNION
    void union(int u, int v) {

        int pu = find(u);
        int pv = find(v);

        if(pu != pv) {
            parent[pv] = pu;
        }
    }

    public int kruskal(int V, int[][] connections) {

        // sort by weight
        Arrays.sort(connections,
                (a,b) -> a[2] - b[2]);

        parent = new int[V];

        for(int i = 0; i < V; i++) {
            parent[i] = i;
        }

        int mstWeight = 0;

        for(int[] edge : connections) {

            int u = edge[0];
            int v = edge[1];
            int wt = edge[2];

            // no cycle
            if(find(u) != find(v)) {

                union(u,v);

                mstWeight += wt;
            }
        }

        return mstWeight;
    }
}

