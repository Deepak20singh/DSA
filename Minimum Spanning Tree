class Solution {

    public int minCost(int[][] houses) {
        // code here
       int n=houses.length;
       
       PriorityQueue<int[]> pq=new PriorityQueue<>((a,b)->a[1]-b[1]);
       
       boolean[] visited=new boolean[n];
       
       pq.offer(new int[]{0,0});
       int totalCost=0;
       int houseVisited=0;
       
       while(!pq.isEmpty()){
           int cur[]=pq.poll();
           
           int house=cur[0];
           int cost=cur[1];
           
           if(visited[house]){
               continue;
           }
           visited[house]=true;
           totalCost+=cost;
           houseVisited++;
           
           if(houseVisited==n){
               return totalCost;
           }
           for(int next=0;next<n;next++){
               if(!visited[next]){
                   int nextCost=Math.abs(houses[house][0]-houses[next][0])+Math.abs(houses[house][1]-houses[next][1]);
                   
                   pq.offer(new int[]{next,nextCost});
               }
           }
       }
       
       return totalCost;
        
    }
}

