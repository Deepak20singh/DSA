import java.util.*;

class Main {

    public int minimumCost(int n, int[][] connections) {

        // Step 1: Sort all edges by cost
        Arrays.sort(connections, (a, b) -> a[2] - b[2]);

        // Step 2: Initially every city is in its own group
        // Cities are numbered from 1 to n, so size should be n + 1
        int[] group = new int[n + 1];

        for (int i = 1; i <= n; i++) {
            group[i] = i;
        }

        int totalCost = 0;
        int edgesUsed = 0;

        // Step 3: Process edges from cheapest to costliest
        for (int[] edge : connections) {
            int city1 = edge[0];
            int city2 = edge[1];
            int cost = edge[2];

            // If both cities belong to different groups,
            // they are not connected yet
            if (group[city1] != group[city2]) {

                // Include this edge in MST
                totalCost += cost;
                edgesUsed++;

                // Merge the two groups
                int oldGroup = group[city2];
                int newGroup = group[city1];

                // All cities in oldGroup become part of newGroup
                for (int i = 1; i <= n; i++) {
                    if (group[i] == oldGroup) {
                        group[i] = newGroup;
                    }
                }

                // If n-1 edges are used, all cities are connected
                if (edgesUsed == n - 1) {
                    return totalCost;
                }
            }
        }

        // If all cities could not be connected
        return -1;
    }

    public static void main(String[] args) {
        Main obj = new Main();

        int n = 3;
        int[][] connections = {
            {1, 2, 5},
            {1, 3, 6},
            {2, 3, 1}
        };

        System.out.println(obj.minimumCost(n, connections)); // Output: 6
    }
}



