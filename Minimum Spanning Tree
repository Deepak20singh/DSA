import java.util.*;

class Solution {

    public int minCost(int[][] houses) {
        int n = houses.length;

        // सभी edges store करेंगे -> {cost, u, v}
        List<int[]> edges = new ArrayList<>();

        // हर pair of houses के बीच Manhattan Distance निकालो
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int cost = Math.abs(houses[i][0] - houses[j][0]) +
                           Math.abs(houses[i][1] - houses[j][1]);

                edges.add(new int[]{cost, i, j});
            }
        }

        // cost के आधार पर sorting
        Collections.sort(edges, (a, b) -> a[0] - b[0]);

        // Parent array (हर node शुरुआत में खुद का parent है)
        int[] parent = new int[n];
        for (int i = 0; i < n; i++) {
            parent[i] = i;
        }

        int totalCost = 0;
        int edgesUsed = 0;

        // Sorted edges पर iterate करो
        for (int[] edge : edges) {
            int cost = edge[0];
            int u = edge[1];
            int v = edge[2];

            // दोनों nodes का ultimate parent निकालो
            int parentU = find(parent, u);
            int parentV = find(parent, v);

            // अगर अलग-अलग group में हैं तभी connect करेंगे
            if (parentU != parentV) {

                // Normal union (कोई rank/size नहीं)
                // parentV वाले group को parentU से जोड़ दो
                parent[parentV] = parentU;

                totalCost += cost;
                edgesUsed++;

                // MST complete हो गया
                if (edgesUsed == n - 1) {
                    return totalCost;
                }
            }
        }

        return totalCost;
    }

    // Ultimate parent निकालने का function
    private int find(int[] parent, int node) {
        while (parent[node] != node) {
            node = parent[node];
        }
        return node;
    }
}
